{
  "name": "crm-custom",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "db:generate": "turbo run db:generate",
    "db:pre-push": "pnpm --filter @crm/database db:pre-push",
    "db:push": "pnpm --filter @crm/database db:push",
    "db:migrate": "pnpm --filter @crm/database db:migrate",
    "db:seed": "pnpm --filter @crm/database db:seed",
    "db:bootstrap-admin": "pnpm --filter @crm/database db:bootstrap-admin",
    "db:studio": "pnpm --filter @crm/database db:studio",
    "test": "turbo run test",
    "test:e2e": "turbo run test:e2e"
  },
  "pnpm": {
    "overrides": {
      "lodash@>=4.0.0 <4.18.0": "4.18.0",
      "defu@<=6.1.4": "6.1.7",
      "hono": ">=4.12.23",
      "fast-uri": ">=3.1.2",
      "ip-address": ">=10.1.1",
      "qs": ">=6.15.2",
      "picomatch": ">=4.0.4",
      "ajv": ">=8.18.0",
      "@eslint/eslintrc>ajv": "^6.12.6",
      "eslint>ajv": "^6.12.6",
      "tmp": ">=0.2.7",
      "brace-expansion@1": "^1.1.12",
      "brace-expansion@2": "^2.0.2",
      "vite": "8.0.14",
      "postcss": ">=8.5.10",
      "express-rate-limit": ">=8.5.2",
      "uuid@11.1.0": "11.1.1"
    }
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.58.2",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "@vitest/coverage-v8": "^4.1.2",
    "eslint": "^9.0.0",
    "eslint-config-prettier": "^10.0.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "playwright": "^1.58.2",
    "turbo": "^2.9.15",
    "typescript-eslint": "^8.57.2",
    "vitest": "^4.1.2"
  }
}
