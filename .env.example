# Database (connection_limit=Prisma pool size, pool_timeout=seconds to wait)
DATABASE_URL=postgresql://crm:crm@localhost:5433/crm_v4?connection_limit=20&pool_timeout=10

# Auth
JWT_SECRET=change-me-to-random-32-chars
ENCRYPTION_KEY=change-me-openssl-rand-hex-32
JWT_REFRESH_SECRET=change-me-to-another-random-32-chars

# Webhook signature (HMAC-SHA256 over raw body) - OPTIONAL.
# Khi không set, webhook chỉ verify qua API key (ApiKeyAuthGuard).
# Khi tích hợp bank API thực require HMAC, uncomment và set giá trị:
#   openssl rand -hex 32
# WEBHOOK_SECRET=

# Server
API_PORT=3010
FRONTEND_URL=http://localhost:3011
NEXT_PUBLIC_API_URL=http://localhost:3010/api/v1

# OmiCall Web SDK - version lay tu OmiCall changelog (Cau hinh > Tong dai)
# Vd: 3.0.1. Neu khong set, SDK provider dung 'latest'.
NEXT_PUBLIC_OMICALL_SDK_VERSION=latest

# OmiCall Contact REST API - dung de sync lead owner sang OmiCall khi assign.
# Base URL lay tu tenant OmiCall (vd staging: https://public-v1-stg.omicall.com).
# API key tu OmiCall admin panel. Khi rong -> module tu disable, khong block CRM.
OMICALL_API_URL=
OMICALL_API_KEY=

# Lark Base sync - day payment moi sang Lark Bitable (config-driven theo kenh).
# App ID/Secret lay tu Lark Developer Console. App phai la collaborator cua tung base.
# LARK_BASE_TOKEN = base mac dinh khi mapping khong chi dinh baseToken rieng.
# Khi thieu APP_ID/SECRET -> module tu disable, khong block CRM.
LARK_APP_ID=
LARK_APP_SECRET=
LARK_BASE_TOKEN=
# Table ID cua 7 kenh sync (lay tu URL bang Lark Bitable). Khi rong -> preset dung placeholder.
LARK_TABLE_1=
LARK_TABLE_2=
LARK_TABLE_3=
LARK_TABLE_4=
LARK_TABLE_5=
LARK_TABLE_6=
LARK_TABLE_7=

# Storage
UPLOAD_DIR=./uploads
REDIS_URL=redis://localhost:6380
# Redis password cho docker-compose.prod.yml (bat buoc khi chay prod)
REDIS_PASSWORD=

# Web Push (VAPID) - thong bao day cho ca khi khong mo web.
# Sinh cap khoa 1 lan: npx web-push generate-vapid-keys --json
# Khi thieu PUBLIC/PRIVATE key -> module push tu disable, khong block CRM.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com
